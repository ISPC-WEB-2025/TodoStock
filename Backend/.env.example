# Configuración general
SECRET_KEY=django-insecure-desarrollo-local-ispc-codelab-2026
DEBUG=True
# Hosts permitidos (separados por coma). En desarrollo se puede omitir o usar '*'
ALLOWED_HOSTS=localhost,127.0.0.1,todostock.alwaysdata.net

# Base de datos MySQL local (por defecto para desarrollo con XAMPP / MySQL local)
DB_NAME=todostock
DB_USER=root
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=3306

# Superadministrador inicial
# Definí tu propia contraseña. Si ADMIN_PASSWORD queda vacío, el script genera una
# contraseña aleatoria y la muestra una sola vez por consola.
ADMIN_EMAIL=admin@codelab.com
ADMIN_PASSWORD=
