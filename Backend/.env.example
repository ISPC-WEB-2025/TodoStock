# Configuración general
SECRET_KEY=django-insecure-desarrollo-local-ispc-codelab-2026
DEBUG=True
# Hosts permitidos (separados por coma). En desarrollo se puede omitir o usar '*'
ALLOWED_HOSTS=localhost,127.0.0.1,todostock.alwaysdata.net
# Límite de intentos fallidos de login por IP y minutos de bloqueo (django-axes)
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15

# Base de datos MySQL local (por defecto para desarrollo con XAMPP / MySQL local)
DB_NAME=todostock
DB_USER=root
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=3306

# Superadministrador inicial (opcional en desarrollo, recomendado en producción)
# Si DEBUG=True y no se modifica ADMIN_PASSWORD, se utiliza la credencial de desarrollo por defecto:
# Email: admin@codelab.com | Password: AdminPassword123!
ADMIN_EMAIL=admin@codelab.com
ADMIN_PASSWORD=AdminPassword123!
